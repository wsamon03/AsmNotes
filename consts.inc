; Rect structure (16 bytes: left, top, right, bottom)
RECT STRUC
    left DWORD ?
    top DWORD ?
    right DWORD ?
    bottom DWORD ?
RECT ENDS

; Point structure (8 bytes: x, y)
POINT STRUC
    x DWORD ?
    y DWORD ?
POINT ENDS

; MSG structure
MSG STRUC
    hwnd QWORD ?
    message DWORD ?
    wParam QWORD ?
    lParam QWORD ?
    time DWORD ?
    pt POINT <>
    lPrivate DWORD ?
MSG ENDS

; CHARFORMAT2 structure (simplified, 116 bytes)
CHARFORMAT2_SIZE EQU 76

; PARAFORMAT2 structure (simplified)
PARAFORMAT2_SIZE EQU 48

; EDITSTREAM structure
EDITSTREAM STRUC
    dwCookie QWORD ?
    pfnCallback QWORD ?
EDITSTREAM ENDS

; NMHDR structure (notification header)
